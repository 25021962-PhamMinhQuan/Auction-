<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>

<StackPane  xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.uicontroller.ItemBidingUIController">

    <ScrollPane fitToWidth="true" styleClass="scroll-pane">
        <content>
            <VBox alignment="TOP_CENTER" spacing="30">
                <padding><Insets bottom="30" left="20" right="20" top="30" /></padding>

                <!-- Back button -->
                <HBox>
                    <Button mnemonicParsing="false" onAction="#handleBack" styleClass="button-login" text="← Back" />
                </HBox>

                <!-- TOP: image + info -->
                <HBox alignment="TOP_LEFT" maxWidth="1200" spacing="40">

                    <ImageView fx:id="itemImage" fitWidth="420" fitHeight="500" preserveRatio="true" />

                    <VBox spacing="15" HBox.hgrow="ALWAYS">

                        <Label fx:id="itemName" styleClass="title" />
                        <Label fx:id="currentPrice" styleClass="item-price" />
                        <Label fx:id="highestBidder" styleClass="label-secondary" />
                        <Label fx:id="timeLeft" styleClass="label-secondary" />

                        <!-- Bid section — hidden in read-only (upcoming) mode -->
                        <VBox fx:id="bidSection" spacing="15">

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <TextField fx:id="bidInput" maxWidth="175.0" promptText="Nhập số tiền đặt bid" styleClass="input_field" HBox.hgrow="ALWAYS" />
                                <Button fx:id="placeBidButton" onAction="#handleBid" styleClass="button-login" text="Place Bid" />
                            </HBox>

                            <VBox spacing="8" styleClass="section-box">
                                <Label styleClass="section-title" text="Auto Bid" />
                                <TextField fx:id="maxBidInput" maxWidth="250.0" promptText="Max price" styleClass="input_field" />
                                <TextField fx:id="incrementInput" maxWidth="250.0" promptText="Increment per bid" styleClass="input_field" />
                                <Button onAction="#handleAutoBid" styleClass="button-login" text="Start Auto Bid" />
                            </VBox>

                        </VBox>

                        <Button onAction="#handleShowHistory" styleClass="button-login" text="Show Bid History" />

                    </VBox>
                </HBox>

                <!-- Description -->
                <VBox maxWidth="1000" spacing="10">
                    <Label styleClass="section-title" text="Description" />
                    <Label fx:id="description" styleClass="item-time" text="des" wrapText="true" />
                </VBox>

                <!-- ===== CHARTS SECTION ===== -->
                <VBox maxWidth="1200" spacing="24">

                    <!-- Line Chart: Biến động giá -->
                    <VBox spacing="10" styleClass="chart-section">
                        <Label styleClass="section-title" text="📈 Biến Động Giá Theo Thời Gian" />
                        <LineChart fx:id="priceLineChart" prefHeight="280.0" animated="false" legendVisible="false"
                                   style="-fx-background-color: transparent;">
                            <xAxis><CategoryAxis fx:id="lineXAxis" label="Thời gian" /></xAxis>
                            <yAxis><NumberAxis fx:id="lineYAxis" label="Giá (VND)" /></yAxis>
                        </LineChart>
                    </VBox>

                    <!-- Bar Chart: Số lượt bid theo giờ -->
                    <VBox spacing="10" styleClass="chart-section">
                        <Label styleClass="section-title" text="🕐 Lượt Bid Theo Giờ Trong Ngày" />
                        <BarChart fx:id="bidBarChart" prefHeight="260.0" animated="false" legendVisible="false"
                                  style="-fx-background-color: transparent;">
                            <xAxis><CategoryAxis label="Giờ" /></xAxis>
                            <yAxis><NumberAxis label="Số lượt bid" /></yAxis>
                        </BarChart>
                    </VBox>

                </VBox>

            </VBox>
        </content>
    </ScrollPane>

    <!-- Backdrop for bid history popup — fills entire StackPane -->
    <Region fx:id="historyBackdrop" managed="false" visible="false"
            maxWidth="1.7976931348623157E308" maxHeight="1.7976931348623157E308"
            style="-fx-background-color: rgba(0,0,0,0.60);" />

    <!-- Bid history popup -->
    <VBox fx:id="historyPopup" managed="false" maxHeight="520" maxWidth="440" styleClass="popup" visible="false" StackPane.alignment="CENTER">
        <padding><Insets bottom="24" left="24" right="24" top="20" /></padding>
        <spacing>12</spacing>

        <HBox alignment="CENTER_LEFT">
            <Label styleClass="section-title" text="Bid History" HBox.hgrow="ALWAYS" />
        </HBox>

        <ScrollPane fitToWidth="true" prefHeight="380" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox fx:id="historyBox" spacing="8">
                    <padding><Insets top="4" bottom="4" /></padding>
                </VBox>
            </content>
        </ScrollPane>

        <Button onAction="#handleCloseHistory" styleClass="button-login" text="Close" />
    </VBox>

</StackPane>
