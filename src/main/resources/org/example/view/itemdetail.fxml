<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.geometry.Insets?>
<StackPane stylesheets="@../../../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.uicontroller.ItemBidingUIController">

    <ScrollPane fitToWidth="true">
        <content>
            <VBox alignment="TOP_CENTER" spacing="30">
                <padding><Insets top="30" bottom="30" left="20" right="20"/></padding>

                <!-- TOP: image + info side by side -->
                <HBox maxWidth="1200" spacing="40" alignment="CENTER">

                    <!-- Item image -->
                    <ImageView fx:id="itemImage"
                               fitWidth="400"
                               preserveRatio="true"
                               HBox.hgrow="ALWAYS"/>


                    <VBox spacing="15" HBox.hgrow="ALWAYS">

                        <Label fx:id="itemName"     styleClass="title"/>
                        <Label fx:id="currentPrice" styleClass="item-price"/>
                        <Label fx:id="highestBidder" styleClass="label-secondary"/>
                        <Label fx:id="timeLeft"      styleClass="label-secondary"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="bidInput"
                                       promptText="Enter bid amount"
                                       styleClass="input_field"
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="Place Bid"
                                    onAction="#handleBid"
                                    styleClass="button-login"/>
                        </HBox>

                        <VBox spacing="8" styleClass="section-box">
                            <Label text="Auto Bid" styleClass="section-title"/>
                            <TextField fx:id="maxBidInput"
                                       promptText="Max price"
                                       styleClass="input_field"/>
                            <TextField fx:id="incrementInput"
                                       promptText="Increment per bid"
                                       styleClass="input_field"/>
                            <Button text="Start Auto Bid"
                                    onAction="#handleAutoBid"
                                    styleClass="button-login"/>
                        </VBox>

                        <Button text="Show Bid History"
                                onAction="#handleShowHistory"
                                styleClass="button-login"/>

                    </VBox>
                </HBox>


                <VBox maxWidth="1000" spacing="10">
                    <Label text="Description" styleClass="section-title"/>
                    <Label fx:id="description" wrapText="true"/>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>


    <VBox  managed="false" maxWidth="400" styleClass="popup" visible="false">

        <Label styleClass="section-title" text="Bid History" />

        <ScrollPane fitToWidth="true">
            <content>
                <VBox fx:id="historyList" spacing="10" />
            </content>
        </ScrollPane>

        <Button onAction="#handleCloseHistory" text="Close" />
    </VBox>
    <VBox fx:id="historyPopup"
          visible="false"
          managed="false"
          maxWidth="420"
          maxHeight="500"
          styleClass="popup"
          StackPane.alignment="CENTER">

        <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
        <spacing>12</spacing>

        <Label text="Bid History" styleClass="section-title"/>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="historyBox" spacing="8"/>
            </content>
        </ScrollPane>

        <Button text="Close"
                onAction="#handleCloseHistory"
                styleClass="button-login"/>

    </VBox>

</StackPane>
