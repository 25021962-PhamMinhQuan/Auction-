<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.uicontroller.AdminScreenController">

    <children>
        <BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="navbar" BorderPane.alignment="CENTER_LEFT">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>

                    <Button mnemonicParsing="false" styleClass="nav-button">
                        <graphic>
                            <ImageView fitHeight="43" fitWidth="93" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../Auction_App.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Label styleClass="admin-badge" text="%admin.badge" />

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER_RIGHT" spacing="20">
                        <padding>
                            <Insets right="10" />
                        </padding>
                        <Label fx:id="adminUsernameLabel" styleClass="label-secondary" text="Admin" />
                        <Button mnemonicParsing="false" onAction="#handleOpenAdminPanel" styleClass="icon-btn">
                            <graphic>
                                <ImageView fitHeight="32" fitWidth="13" pickOnBounds="true" preserveRatio="true" styleClass="icon-img">
                                    <image>
                                        <Image url="@../../../icon_user.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>
            </top>

            <center>
                <HBox BorderPane.alignment="CENTER">

                    <VBox spacing="4" styleClass="admin-sidebar">
                        <padding>
                            <Insets bottom="24" left="0" right="0" top="24" />
                        </padding>

                        <Label styleClass="sidebar-section-label" text="%admin.sidebar.overview" />
                        <Button fx:id="navDashboard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showDashboard" styleClass="sidebar-btn" text="%admin.nav.dashboard" />

                        <Label styleClass="sidebar-section-label" text="%admin.sidebar.management">
                            <VBox.margin>
                                <Insets top="16" />
                            </VBox.margin>
                        </Label>
                        <Button fx:id="navUsers" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showUserManagement" styleClass="sidebar-btn" text="%admin.nav.accounts" />
                        <Button fx:id="navItems" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showItemManagement" styleClass="sidebar-btn" text="%admin.nav.items" />
                        <Button fx:id="navAuctions" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showAuctionManagement" styleClass="sidebar-btn" text="%admin.nav.auctions" />
                        <Button fx:id="navDeposits" maxWidth="1.7976931348623157E308"
                                onAction="#showDepositManagement" styleClass="sidebar-btn" text="%admin.nav.deposits"/>


                        <Region VBox.vgrow="ALWAYS" />

                        <Separator />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" styleClass="sidebar-btn-danger" text="%admin.nav.logout" />
                    </VBox>

                    <ScrollPane fitToWidth="true" styleClass="scroll-pane" HBox.hgrow="ALWAYS">
                        <content>
                            <VBox fx:id="contentArea" spacing="0">

                                <VBox fx:id="sectionDashboard" spacing="24" styleClass="admin-content-section">
                                    <padding>
                                        <Insets bottom="28" left="28" right="28" top="28" />
                                    </padding>

                                    <Label styleClass="admin-page-title" text="%admin.dashboard.heading" />
                                    <Label styleClass="admin-page-subtitle" text="%admin.dashboard.title" />

                                    <HBox spacing="16">
                                        <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                            <Label styleClass="stat-icon" text="👥" />
                                            <Label fx:id="statTotalUsers" styleClass="stat-number" text="0" />
                                            <Label styleClass="stat-label" text="%admin.stat.total_users" />
                                        </VBox>

                                        <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                            <Label styleClass="stat-icon" text="🏷️" />
                                            <Label fx:id="statTotalItems" styleClass="stat-number" text="0" />
                                            <Label styleClass="stat-label" text="%admin.stat.total_items" />
                                        </VBox>

                                        <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                            <Label styleClass="stat-icon" text="🔨" />
                                            <Label fx:id="statActiveAuctions" styleClass="stat-number" text="0" />
                                            <Label styleClass="stat-label" text="%admin.stat.active_auctions" />
                                        </VBox>

                                        <VBox spacing="8" styleClass="stat-card stat-card-accent" HBox.hgrow="ALWAYS">
                                            <Label styleClass="stat-icon" text="💰" />
                                            <Label fx:id="statTotalRevenue" styleClass="stat-number-accent" text="0 ₫" />
                                            <Label styleClass="stat-label" text="%admin.stat.total_revenue" />
                                        </VBox>
                                    </HBox>

                                    <HBox spacing="16">
                                        <VBox spacing="12" styleClass="admin-card" HBox.hgrow="ALWAYS">
                                            <Label styleClass="admin-card-title" text="%admin.recent_activity" />
                                            <Separator />
                                            <VBox fx:id="recentActivityList" spacing="8" />
                                            <Button mnemonicParsing="false" styleClass="button-link" text="%admin.btn.view_all" />
                                        </VBox>

                                        <VBox prefWidth="280" spacing="12" styleClass="admin-card">
                                            <Label styleClass="admin-card-title" text="%admin.quick_stats" />
                                            <Separator />
                                            <HBox styleClass="quick-stat-row">
                                                <Label styleClass="quick-stat-label" text="%admin.stat.banned" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="statBanned" styleClass="quick-stat-value-danger" text="0" />
                                            </HBox>
                                            <HBox styleClass="quick-stat-row">
                                                <Label styleClass="quick-stat-label" text="%admin.stat.upcoming" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="statUpcoming" styleClass="quick-stat-value" text="0" />
                                            </HBox>
                                            <HBox styleClass="quick-stat-row">
                                                <Label styleClass="quick-stat-label" text="%admin.stat.pending_items" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="statPendingItems" styleClass="quick-stat-value-warn" text="0" />
                                            </HBox>
                                            <HBox styleClass="quick-stat-row">
                                                <Label styleClass="quick-stat-label" text="%admin.stat.today_bids" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="statTodayBids" styleClass="quick-stat-value" text="0" />
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <VBox fx:id="sectionUsers" managed="false" spacing="20" styleClass="admin-content-section" visible="false">
                                    <padding>
                                        <Insets bottom="28" left="28" right="28" top="28" />
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="admin-page-title" text="%admin.users.title" />
                                            <Label styleClass="admin-page-subtitle" text="%admin.users.subtitle" />
                                        </VBox>
                                        <Button mnemonicParsing="false" onAction="#refreshUsers" styleClass="button-secondary" text="%common.refresh" />
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar-bar">
                                        <TextField fx:id="userSearchField" promptText="%admin.users.search" styleClass="admin-search-field" HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#filterLockedUsers" styleClass="filter-btn" text="%admin.filter.locked" />
                                        <Button mnemonicParsing="false" onAction="#filterAllUsers" styleClass="filter-btn filter-btn-active" text="%admin.filter.all" />
                                    </HBox>

                                    <TableView fx:id="userTable" styleClass="admin-table">
                                        <columns>
                                            <TableColumn fx:id="colUserId" prefWidth="60" text="%admin.col.id" />
                                            <TableColumn fx:id="colUsername" prefWidth="180" text="%admin.col.username" />
                                            <TableColumn fx:id="colEmail" prefWidth="220" text="%admin.col.email" />
                                            <TableColumn fx:id="colRole" prefWidth="90" text="%admin.col.role" />
                                            <TableColumn fx:id="colUserStatus" prefWidth="100" text="%admin.col.status" />
                                            <TableColumn fx:id="colUserDate" prefWidth="140" text="%admin.col.created_at" />
                                        </columns>
                                    </TableView>

                                    <HBox spacing="12">
                                        <Button fx:id="btnBanUser" mnemonicParsing="false" onAction="#handleBanUser" styleClass="btn-warn" text="%admin.user.lock" />
                                        <Button fx:id="btnUnbanUser" mnemonicParsing="false" onAction="#handleUnbanUser" styleClass="button-secondary" text="%admin.user.unlock" />
                                        <Button fx:id="btnViewUserDetail" mnemonicParsing="false" onAction="#handleViewUserDetail" styleClass="button-secondary" text="%admin.btn.view_detail" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnDeleteUser" mnemonicParsing="false" onAction="#handleDeleteUser" styleClass="btn-danger" text="%admin.user.delete" />
                                    </HBox>
                                </VBox>

                                <VBox fx:id="sectionItems" managed="false" spacing="20" styleClass="admin-content-section" visible="false">
                                    <padding>
                                        <Insets bottom="28" left="28" right="28" top="28" />
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="admin-page-title" text="%admin.items.title" />
                                            <Label styleClass="admin-page-subtitle" text="%admin.items.subtitle" />
                                        </VBox>
                                        <Button mnemonicParsing="false" onAction="#refreshItems" styleClass="button-secondary" text="%common.refresh" />
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar-bar">
                                        <TextField fx:id="itemSearchField" promptText="%admin.items.search" styleClass="admin-search-field" HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#filterPendingItems" styleClass="filter-btn" text="%admin.filter.pending" />
                                        <Button mnemonicParsing="false" onAction="#filterActiveItems" styleClass="filter-btn" text="%admin.filter.active" />
                                        <Button mnemonicParsing="false" onAction="#filterAllItems" styleClass="filter-btn filter-btn-active" text="%admin.filter.all" />
                                    </HBox>

                                    <TableView fx:id="itemTable" styleClass="admin-table">
                                        <columns>
                                            <TableColumn fx:id="colItemId" prefWidth="60" text="%admin.col.id" />
                                            <TableColumn fx:id="colItemName" prefWidth="220" text="%admin.col.item_name" />
                                            <TableColumn fx:id="colItemSeller" prefWidth="140" text="%admin.col.seller" />
                                            <TableColumn fx:id="colItemCategory" prefWidth="110" text="%admin.col.category" />
                                            <TableColumn fx:id="colItemPrice" prefWidth="120" text="%admin.col.start_price" />
                                            <TableColumn fx:id="colItemStatus" prefWidth="110" text="%admin.col.status" />
                                        </columns>
                                    </TableView>

                                    <HBox spacing="12">
                                        <Button fx:id="btnApproveItem" mnemonicParsing="false" onAction="#handleApproveItem" styleClass="button-login" text="%admin.item.approve" />
                                        <Button fx:id="btnViewItemDetail" mnemonicParsing="false" onAction="#handleViewItemDetail" styleClass="button-secondary" text="%admin.btn.view_detail" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnDeleteItem" mnemonicParsing="false" onAction="#handleDeleteItem" styleClass="btn-danger" text="%admin.item.delete" />
                                    </HBox>
                                </VBox>

                                <VBox fx:id="sectionAuctions" managed="false" spacing="20" styleClass="admin-content-section" visible="false">
                                    <padding>
                                        <Insets bottom="28" left="28" right="28" top="28" />
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="admin-page-title" text="%admin.auction.title" />
                                            <Label styleClass="admin-page-subtitle" text="%admin.auction.subtitle" />
                                        </VBox>
                                        <Button mnemonicParsing="false" onAction="#refreshAuctions" styleClass="button-secondary" text="%common.refresh" />
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar-bar">
                                        <TextField fx:id="auctionSearchField" promptText="%admin.auction.search" styleClass="admin-search-field" HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" styleClass="filter-btn" text="%admin.filter.running" />
                                        <Button mnemonicParsing="false" styleClass="filter-btn" text="%admin.filter.upcoming" />
                                        <Button mnemonicParsing="false" styleClass="filter-btn filter-btn-active" text="%admin.filter.all" />
                                    </HBox>

                                    <TableView fx:id="auctionTable" styleClass="admin-table">
                                        <columns>
                                            <TableColumn fx:id="colAuctionId" prefWidth="60" text="%admin.col.id" />
                                            <TableColumn fx:id="colAuctionItem" prefWidth="200" text="%admin.col.item" />
                                            <TableColumn fx:id="colAuctionStart" prefWidth="150" text="%admin.col.start" />
                                            <TableColumn fx:id="colAuctionEnd" prefWidth="150" text="%admin.col.end" />
                                            <TableColumn fx:id="colAuctionPrice" prefWidth="130" text="%admin.col.current_price" />
                                            <TableColumn fx:id="colAuctionStatus" prefWidth="110" text="%admin.col.status" />
                                        </columns>
                                    </TableView>

                                    <HBox spacing="12">
                                        <Button fx:id="btnStopAuction" mnemonicParsing="false" onAction="#handleStopAuction" styleClass="btn-warn" text="%admin.auction.stop" />
                                        <Button fx:id="btnViewAuction" mnemonicParsing="false" onAction="#handleViewAuction" styleClass="button-secondary" text="%admin.btn.view_detail" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnDeleteAuction" mnemonicParsing="false" onAction="#handleDeleteAuction" styleClass="btn-danger" text="%admin.auction.delete" />
                                    </HBox>
                                </VBox>

                                <VBox fx:id="sectionDeposits" managed="false" spacing="20" styleClass="admin-content-section" visible="false">
                                    <padding>
                                        <Insets bottom="28" left="28" right="28" top="28" />
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label styleClass="admin-page-title" text="%admin.deposits.title" />
                                            <Label styleClass="admin-page-subtitle" text="%admin.deposits.subtitle" />
                                        </VBox>
                                        <Button mnemonicParsing="false" onAction="#refreshDeposits" styleClass="button-secondary" text="%common.refresh" />
                                    </HBox>

                                    <!-- Filter buttons -->
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar-bar">
                                        <Button fx:id="depositFilterAll" mnemonicParsing="false" onAction="#filterAllDeposits"
                                                styleClass="filter-btn, filter-btn-active" text="%admin.filter.all" />
                                        <Button fx:id="depositFilterPending" mnemonicParsing="false" onAction="#filterPendingDeposits"
                                                styleClass="filter-btn" text="%admin.filter.pending" />
                                        <Button fx:id="depositFilterApproved" mnemonicParsing="false" onAction="#filterApprovedDeposits"
                                                styleClass="filter-btn" text="%admin.filter.approved" />
                                        <Button fx:id="depositFilterRejected" mnemonicParsing="false" onAction="#filterRejectedDeposits"
                                                styleClass="filter-btn" text="%admin.filter.rejected" />
                                    </HBox>

                                    <TableView fx:id="depositTable" styleClass="admin-table">
                                        <columns>
                                            <TableColumn fx:id="colDepositId"       prefWidth="55"  text="%admin.col.id" />
                                            <TableColumn fx:id="colDepositUser"     prefWidth="130" text="%admin.col.user" />
                                            <TableColumn fx:id="colDepositAmount"   prefWidth="140" text="%admin.col.amount" />
                                            <TableColumn fx:id="colDepositNote"     prefWidth="180" text="%admin.col.note" />
                                            <TableColumn fx:id="colDepositStatus"   prefWidth="100" text="%admin.col.status" />
                                            <TableColumn fx:id="colDepositDate"     prefWidth="150" text="%admin.col.time" />
                                        </columns>
                                    </TableView>

                                    <HBox spacing="12">
                                        <Button fx:id="btnApproveDeposit" mnemonicParsing="false" onAction="#handleApproveDeposit"
                                                styleClass="btn-panel-primary" text="%admin.deposit.approve" />
                                        <Button fx:id="btnRejectDeposit"  mnemonicParsing="false" onAction="#handleRejectDeposit"
                                                styleClass="btn-warn" text="%admin.deposit.reject" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="depositActionInfo" styleClass="label-secondary" text="" />
                                    </HBox>
                                </VBox>

                            </VBox>
                        </content>
                    </ScrollPane>

                </HBox>
            </center>
        </BorderPane>

        <AnchorPane fx:id="overlayAdminPanel" managed="false" visible="false">
            <children>
                <VBox fx:id="adminPanelContent" alignment="TOP_CENTER" layoutX="880" prefHeight="700.0" prefWidth="320.0" spacing="16" styleClass="dashboard-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                    <HBox prefWidth="320">
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleCloseAdminPanel" prefHeight="40" prefWidth="47" styleClass="nav-button" text="✕" />
                    </HBox>

                    <Label styleClass="admin-avatar-icon" text="🛡" />
                    <Label styleClass="label-secondary" text="%admin.role" />
                    <Label fx:id="panelAdminName" styleClass="item-name" text="Admin" />

                    <Separator />

                    <VBox spacing="12">
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="%admin.system_settings" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" styleClass="nav-button" text="%admin.nav.logout" />
                    </VBox>
                </VBox>
            </children>
        </AnchorPane>

        <StackPane fx:id="confirmOverlay" managed="false" styleClass="confirm-overlay" visible="false">
            <VBox alignment="CENTER" maxWidth="400" spacing="16" styleClass="confirm-dialog">
                <Label fx:id="confirmTitle" styleClass="confirm-title" text="%common.confirm" />
                <Label fx:id="confirmMessage" styleClass="confirm-message" text="%admin.confirm.default_message" wrapText="true" />
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="confirmCancelBtn" mnemonicParsing="false" onAction="#handleConfirmCancel" prefWidth="120" styleClass="button-secondary" text="%common.cancel" />
                    <Button fx:id="confirmOkBtn" mnemonicParsing="false" onAction="#handleConfirmOk" prefWidth="120" styleClass="btn-danger" text="%common.confirm" />
                </HBox>
            </VBox>
        </StackPane>

    </children>
</StackPane>