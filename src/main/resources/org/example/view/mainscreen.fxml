<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.uicontroller.MainScreenController">

   <children>

      <!-- Preview Overlay -->
      <AnchorPane fx:id="previewOverlay" managed="false" prefHeight="400.0" prefWidth="500.0" visible="false" StackPane.alignment="CENTER">

         <children>

            <StackPane fx:id="previewPanel" alignment="TOP_CENTER" layoutX="78.0" layoutY="74.0" prefHeight="400.0" prefWidth="600.0">

               <children>

                  <VBox prefHeight="200.0" prefWidth="100.0">

                     <children>

                        <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">

                           <children>

                              <Region prefHeight="200.0" prefWidth="200.0" />

                              <Button mnemonicParsing="false" text="Button" />

                           </children>

                        </HBox>

                     </children>

                  </VBox>

               </children>

            </StackPane>

         </children>

      </AnchorPane>

      <!-- Main Layout -->
      <BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root">

         <!-- TOP NAVBAR -->
         <top>

            <VBox styleClass="navbar-wrapper">

               <!-- Main navbar row -->
               <HBox alignment="CENTER_LEFT" spacing="4" styleClass="navbar" BorderPane.alignment="CENTER_LEFT">

                  <padding>
                     <Insets bottom="0" left="24" right="16" top="0" />
                  </padding>

                  <!-- Logo -->
                  <Button mnemonicParsing="false" styleClass="nav-logo-btn">
                     <graphic>
                        <ImageView fitHeight="36" fitWidth="80" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../Auction_App.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>

                  <!-- Divider -->
                  <Region prefWidth="16" />

                  <!-- Nav Links -->
                  <!-- Categories dropdown trigger -->
                  <StackPane fx:id="categoryBox">
                     <Button fx:id="categoryButton" maxHeight="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-link" text="Categories ▾" />
                  </StackPane>

                  <!-- Auctions dropdown trigger -->
                  <StackPane fx:id="auctionBox">
                     <Button fx:id="auctionButton" maxHeight="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-link" text="Auctions ▾" />
                  </StackPane>

                  <Button fx:id="introButton" maxHeight="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-link" text="Introduction" />
                  <Button fx:id="contactButton" maxHeight="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-link" text="Contact" />

                  <Region HBox.hgrow="ALWAYS" />

                  <!-- Right Side -->
                  <HBox alignment="CENTER" spacing="10">
                     <padding>
                        <Insets right="4" />
                     </padding>

                     <!-- Add Item Button -->
                     <Button fx:id="addItemBtn"
                             managed="false"
                             mnemonicParsing="false"
                             onAction="#handleAddItem"
                             styleClass="btn-add-item"
                             text="+ Add Item"
                             visible="false"/>

                     <!-- Search Bar -->
                     <StackPane fx:id="searchContainer" styleClass="search-container">
                        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="search-box">
                           <ImageView fitWidth="16" fitHeight="16" pickOnBounds="true" styleClass="search-icon">
                              <image>
                                 <Image url="@../../../find_icon.png" />
                              </image>
                           </ImageView>
                           <TextField fx:id="searchField"
                                      promptText="Search auctions..."
                                      prefWidth="200"
                                      onAction="#handleSearch"
                                      styleClass="search-field" />
                           <HBox.margin>
                              <Insets left="8" />
                           </HBox.margin>
                        </HBox>
                     </StackPane>

                     <!-- User Avatar Button -->
                     <Button mnemonicParsing="false" onAction="#handleDashboard" styleClass="nav-avatar-btn">
                        <graphic>
                           <HBox alignment="CENTER" spacing="8">
                              <StackPane fx:id="navAvatarPane" styleClass="avatar-circle"
                                         minWidth="26" minHeight="26" maxWidth="26" maxHeight="26">
                                 <ImageView fx:id="navAvatarView"
                                            fitHeight="26" fitWidth="26"
                                            preserveRatio="false" visible="false"/>
                                 <ImageView fx:id="navDefaultIcon"
                                            fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image><Image url="@../../../icon_user.png"/></image>
                                 </ImageView>
                              </StackPane>
                              <Label fx:id="usernameLabel" styleClass="nav-username" text="Guest" mouseTransparent="true" />
                           </HBox>
                        </graphic>
                     </Button>

                  </HBox>

               </HBox>

               <!-- Accent bottom line -->
               <Region styleClass="navbar-accent-line" prefHeight="3" />

            </VBox>

         </top>

         <!-- CENTER -->
         <center>

            <ScrollPane fitToWidth="true" styleClass="scroll-pane" BorderPane.alignment="CENTER">

               <content>

                  <VBox styleClass="main-content-wrapper">

                     <!-- Back Button -->
                     <Button fx:id="backButton" managed="false" mnemonicParsing="false" onAction="#handleBack" styleClass="button-login" text="← Back" visible="false">

                        <VBox.margin>
                           <Insets bottom="10" left="10" right="10" top="10" />
                        </VBox.margin>

                     </Button>

                     <!-- Grid -->
                     <ScrollPane fx:id="gridScroll" styleClass="scroll-pane" fitToWidth="true" managed="false" visible="false">

                        <content>

                           <FlowPane fx:id="gridPane" hgap="20" styleClass="grid-pane" vgap="20" />

                        </content>

                     </ScrollPane>

                     <!-- Main Content -->
                     <VBox fx:id="mainContent" styleClass="main-content-wrapper" alignment="TOP_CENTER" spacing="20">

                        <padding>
                           <Insets top="40" />
                        </padding>

                        <!-- Upcoming -->
                        <Label fx:id="upcomingTitleLabel" styleClass="section-title" text="Upcoming Auction" />

                        <ScrollPane fitToWidth="false" styleClass="scroll-pane" hbarPolicy="ALWAYS" vbarPolicy="NEVER">

                           <content>
                              <HBox fx:id="upcomingHbox" styleClass="main-content-wrapper" spacing="20" />
                           </content>

                        </ScrollPane>

                        <Button fx:id="viewAllUpcoming" mnemonicParsing="false" onAction="#handleViewAllUpcoming" styleClass="button-login" text="View all" />

                        <!-- Ongoing -->
                        <Label fx:id="ongoingTitleLabel" styleClass="section-title"  text="Ongoing Auction" />

                        <ScrollPane fitToWidth="false" styleClass="scroll-pane" hbarPolicy="ALWAYS" vbarPolicy="NEVER">

                           <content>
                              <HBox fx:id="ongoingHbox" styleClass="main-content-wrapper" spacing="20" />
                           </content>

                        </ScrollPane>

                        <Button fx:id="viewAllOngoing" mnemonicParsing="false" onAction="#handleViewAllOngoing" styleClass="button-login" text="View all" />

                     </VBox>

                  </VBox>

               </content>

            </ScrollPane>

         </center>

      </BorderPane>

      <!-- Side Panel / User Dashboard -->
      <AnchorPane fx:id="overlayDashboard" managed="false" prefHeight="490.0" prefWidth="804.0" visible="false" styleClass="overlay-backdrop">

         <children>

            <VBox fx:id="dashboardPanel" prefHeight="700.0" prefWidth="300.0" styleClass="dashboard-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

               <children>

                  <!-- Panel Header with close button -->
                  <HBox alignment="CENTER_LEFT" styleClass="panel-header">
                     <Label fx:id="myAccountLabel" styleClass="panel-header-title" text="My Account" HBox.hgrow="ALWAYS" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button mnemonicParsing="false" onAction="#handleCloseDashboard" styleClass="panel-close-btn" text="✕" />
                  </HBox>

                  <!-- User Profile Card -->
                  <VBox alignment="CENTER" spacing="12" styleClass="panel-profile-card">
                     <padding>
                        <Insets top="24" bottom="24" left="20" right="20" />
                     </padding>

                     <!-- Avatar -->
                     <StackPane fx:id="panelAvatarPane" alignment="CENTER" styleClass="panel-avatar-wrap"
                                minWidth="72" minHeight="72" maxWidth="72" maxHeight="72">
                        <ImageView fx:id="panelAvatarView"
                                   fitWidth="72" fitHeight="72"
                                   preserveRatio="false" visible="false"/>
                        <Label fx:id="panelAvatarIcon" styleClass="panel-avatar-icon" text="👤"/>
                     </StackPane>

                     <!-- Name & Role -->
                     <Label fx:id="panelUsernameLabel" styleClass="panel-username" text="Label" />
                     <Label fx:id="panelRoleLabel" styleClass="panel-role-badge" text="Username" />

                     <!-- Edit Profile Button -->
                     <Button fx:id="editProfileBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-panel-primary" text="✏  Edit Profile"  onAction="#handleOpenProfile">
                        <VBox.margin>
                           <Insets top="8" />
                        </VBox.margin>
                     </Button>
                  </VBox>

                  <!-- Section label -->
                  <HBox alignment="CENTER_LEFT" styleClass="panel-section-header">
                     <padding>
                        <Insets top="20" bottom="8" left="20" right="20" />
                     </padding>
                     <Label fx:id="accountSectionLabel" styleClass="panel-section-label" text="ACCOUNT" />
                     <Region HBox.hgrow="ALWAYS" />
                  </HBox>

                  <!-- Navigation Buttons -->
                  <VBox spacing="2" styleClass="panel-nav-group">
                     <padding>
                        <Insets left="12" right="12" />
                     </padding>

                     <!-- Settings accordion trigger -->
                     <Button fx:id="settingsBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                             onAction="#handleToggleSettings"
                             styleClass="panel-nav-btn" text="⚙   Settings  ▾" />

                     <!-- Settings sub-panel (toggled by controller) -->
                     <VBox fx:id="settingsSubPanel" managed="false" visible="false" styleClass="settings-sub-panel" spacing="0">
                        <padding>
                           <Insets top="4" bottom="4" left="4" right="4" />
                        </padding>

                        <!-- Language Row -->
                        <HBox alignment="CENTER_LEFT" styleClass="settings-row" spacing="10">
                           <padding>
                              <Insets top="10" bottom="10" left="12" right="12" />
                           </padding>
                           <Label fx:id="languageSettingLabel" styleClass="settings-row-label" text="🌐  Language" HBox.hgrow="ALWAYS" />
                           <Region HBox.hgrow="ALWAYS" />
                           <HBox styleClass="toggle-group-box" spacing="0">
                              <Button fx:id="langEnBtn" mnemonicParsing="false" onAction="#handleLangEn"
                                      styleClass="toggle-btn-left, toggle-btn-active" text="EN" />
                              <Button fx:id="langViBtn" mnemonicParsing="false" onAction="#handleLangVi"
                                      styleClass="toggle-btn-right" text="VI" />
                           </HBox>
                        </HBox>

                        <!-- Separator line -->
                        <Region styleClass="settings-row-divider" prefHeight="1" />

                        <!-- Theme Row -->
                        <HBox alignment="CENTER_LEFT" styleClass="settings-row" spacing="10">
                           <padding>
                              <Insets top="10" bottom="10" left="12" right="12" />
                           </padding>
                           <Label fx:id="themeSettingLabel" styleClass="settings-row-label" text="☀   Theme" HBox.hgrow="ALWAYS" />
                           <Region HBox.hgrow="ALWAYS" />
                           <HBox styleClass="toggle-group-box" spacing="0">
                              <Button fx:id="themeLightBtn" mnemonicParsing="false" onAction="#handleThemeLight"
                                      styleClass="toggle-btn-left" text="☀" />
                              <Button fx:id="themeDarkBtn" mnemonicParsing="false" onAction="#handleThemeDark"
                                      styleClass="toggle-btn-right, toggle-btn-active" text="🌙" />
                           </HBox>
                        </HBox>

                     </VBox>

                  </VBox>

                  <!-- Spacer -->
                  <Region VBox.vgrow="ALWAYS" />

                  <!-- Divider -->
                  <Separator styleClass="panel-separator">
                     <VBox.margin>
                        <Insets left="20" right="20" />
                     </VBox.margin>
                  </Separator>

                  <!-- Logout at bottom -->
                  <VBox spacing="4" styleClass="panel-nav-group">
                     <padding>
                        <Insets top="12" left="12" right="12" bottom="24" />
                     </padding>
                     <Button fx:id="logOutBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="panel-logout-btn" text="⏻   Log Out" onAction="#handleLogout" />
                  </VBox>

               </children>

            </VBox>

         </children>

      </AnchorPane>

      <!-- FLOATING DROPDOWN OVERLAYS (rendered on top of everything) -->
      <AnchorPane mouseTransparent="false" managed="false" visible="true" pickOnBounds="false">

         <!-- Categories floating menu -->
         <VBox fx:id="categoryMenu" managed="false" visible="false" styleClass="dropdown-menu-float"
               AnchorPane.topAnchor="62" AnchorPane.leftAnchor="160">
            <Button fx:id="catArtBtn" mnemonicParsing="false" styleClass="dropdown-item" text="🎨  Art"         onAction="#handleCategory" userData="ART" />
            <Button fx:id="catElectronicsBtn" mnemonicParsing="false" styleClass="dropdown-item" text="💻  Electronics" onAction="#handleCategory" userData="ELECTRONICS" />
            <Button fx:id="catEstateBtn" mnemonicParsing="false" styleClass="dropdown-item" text="🏠  Estate"      onAction="#handleCategory" userData="ESTATE" />
            <Button fx:id="catFashionsBtn" mnemonicParsing="false" styleClass="dropdown-item" text="👗  Fashions"    onAction="#handleCategory" userData="FASHIONS" />
            <Button fx:id="catVehivlesBtn" mnemonicParsing="false" styleClass="dropdown-item" text="🚗  Vehicles"    onAction="#handleCategory" userData="VEHICLES" />
            <Button fx:id="catOthersBtn" mnemonicParsing="false" styleClass="dropdown-item" text="📦  Others"      onAction="#handleCategory" userData="OTHERS" />
         </VBox>

         <!-- Auctions floating menu -->
         <VBox fx:id="auctionMenu" managed="false" visible="false" styleClass="dropdown-menu-float"
               AnchorPane.topAnchor="62" AnchorPane.leftAnchor="290">
            <Button fx:id="auctionUpcomingBtn" mnemonicParsing="false" styleClass="dropdown-item" text="⏰  Upcoming" onAction="#handleViewAllUpcoming" />
            <Button fx:id="auctionOngoingBtn" mnemonicParsing="false" styleClass="dropdown-item" text="🔴  Ongoing" onAction="#handleViewAllOngoing" />
         </VBox>

         <!-- Suggestion box — position updated dynamically by controller -->
         <VBox fx:id="suggestionBox"
               managed="false"
               visible="false"
               styleClass="suggest-dropdown"
               AnchorPane.topAnchor="62" AnchorPane.rightAnchor="54" />

      </AnchorPane>

   </children>

</StackPane>
