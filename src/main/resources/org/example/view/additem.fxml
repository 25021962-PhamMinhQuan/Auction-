<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.uicontroller.AddItemController">

   <!-- NAVBAR giản lược -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="navbar">
         <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>
         <Button mnemonicParsing="false" onAction="#handleBack" styleClass="button-secondary" text="%common.back" />
         <Label styleClass="section-title" text="%additem.manage_title" />
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" styleClass="scroll-pane" BorderPane.alignment="CENTER">
         <content>
            <HBox alignment="TOP_CENTER" spacing="40">
               <padding><Insets bottom="40" left="40" right="40" top="30" /></padding>

               <!-- ═══ LEFT: Form thêm item mới ═══ -->
               <VBox prefWidth="420" spacing="14">
                  <Label styleClass="datetime-label" text="%additem.image.label" />
                  <HBox alignment="CENTER_LEFT" spacing="8">
                     <Button mnemonicParsing="false" onAction="#handleChooseImage" styleClass="button-login" text="%additem.image.choose_button" />
                     <Label fx:id="imagePathLabel" style="-fx-text-fill: #6c757d;" text="%additem.image.none" />
                  </HBox>
                  <ImageView fx:id="imagePreview" fitHeight="200" fitWidth="380" pickOnBounds="true" preserveRatio="true">
                  </ImageView>
                  <Label styleClass="section-title" text="%additem.title" />

                  <Label styleClass="datetime-label" text="%additem.type" />
                  <ComboBox fx:id="typeCombo" maxWidth="Infinity" styleClass="time-combo" />

                  <Label styleClass="datetime-label" text="%additem.name" />
                  <TextField fx:id="nameField" promptText="%additem.name.placeholder" styleClass="input_field" />

                  <Label styleClass="datetime-label" text="%additem.description" />
                  <TextField fx:id="descField" promptText="%additem.description.placeholder" styleClass="input_field" />

                  <Label styleClass="datetime-label" text="%additem.start_price" />
                  <TextField fx:id="priceField" promptText="%additem.price.placeholder" styleClass="input_field" />
                  <Label styleClass="datetime-label" text="%additem.start_time" />
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
                     <children>
                        <DatePicker fx:id="startDatePicker" prefWidth="185.0" promptText="%additem.date.placeholder" />
                        <ComboBox fx:id="startHourCombo" prefWidth="72.0" promptText="%additem.hour.placeholder" styleClass="time-combo" />
                        <Label styleClass="time-separator" text=":" />
                        <ComboBox fx:id="startMinuteCombo" prefWidth="72.0" promptText="%additem.minute.placeholder" styleClass="time-combo" />
                     </children>
                  </HBox>
                  <Label styleClass="datetime-label" text="%additem.end_time" />
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0">
                     <children>
                        <DatePicker fx:id="endDatePicker" prefWidth="185.0" promptText="%additem.date.placeholder" />
                        <ComboBox fx:id="endHourCombo" prefWidth="72.0" promptText="%additem.hour.placeholder" styleClass="time-combo" />
                        <Label styleClass="time-separator" text=":" />
                        <ComboBox fx:id="endMinuteCombo" prefWidth="72.0" promptText="%additem.minute.placeholder" styleClass="time-combo" />
                     </children>
                  </HBox>

                  <Button fx:id="submitBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSubmit" styleClass="button-login" text="%additem.btn" />

                  <Label fx:id="statusLabel" wrapText="true" />
               </VBox>

               <!-- ═══ RIGHT: Danh sách item của seller ═══ -->
               <VBox prefWidth="420" spacing="12" VBox.vgrow="ALWAYS">
                  <Label styleClass="section-title" text="%additem.my_items" />
                  <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefHeight="500" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="myItemsBox" spacing="10">
                           <padding><Insets bottom="10" right="4" /></padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </VBox>

            </HBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>