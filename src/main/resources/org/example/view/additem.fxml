<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="root" stylesheets="@../../../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.uicontroller.AddItemController">

   <!-- NAVBAR giản lược -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="navbar">
         <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>
         <Button mnemonicParsing="false" onAction="#handleBack" styleClass="nav-button" text="← Quay lại" />
         <Label styleClass="section-title" text="Quản lý Item (Seller)" />
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <HBox alignment="TOP_CENTER" spacing="40">
               <padding><Insets bottom="40" left="40" right="40" top="30" /></padding>

               <!-- ═══ LEFT: Form thêm item mới ═══ -->
               <VBox prefWidth="420" spacing="14">
                  <Label styleClass="section-title" text="Thêm Item Mới" />

                  <Label text="Loại item" />
                  <ComboBox fx:id="typeCombo" maxWidth="Infinity" />

                  <Label text="Tên item" />
                  <TextField fx:id="nameField" promptText="VD: Tranh sơn dầu thế kỷ 18" styleClass="input_field" />

                  <Label text="Mô tả" />
                  <TextField fx:id="descField" promptText="Nhập mô tả" styleClass="input_field" />

                  <Label text="Giá khởi điểm (VND)" />
                  <TextField fx:id="priceField" promptText="VD: 500000" styleClass="input_field" />

                  <Label text="Thời gian bắt đầu (dd/MM/yyyy HH:mm)" />
                  <TextField fx:id="startTimeField" promptText="VD: 25/05/2026 09:00" styleClass="input_field" />

                  <Label text="Thời gian kết thúc (dd/MM/yyyy HH:mm)" />
                  <TextField fx:id="endTimeField" promptText="VD: 25/05/2026 21:00" styleClass="input_field" />

                  <Button fx:id="submitBtn" maxWidth="Infinity" mnemonicParsing="false" styleClass="button-login" text="+ Thêm Item" />

                  <Label fx:id="statusLabel" wrapText="true" />
               </VBox>

               <!-- ═══ RIGHT: Danh sách item của seller ═══ -->
               <VBox prefWidth="420" spacing="12" VBox.vgrow="ALWAYS">
                  <Label styleClass="section-title" text="Item Của Bạn" />
                  <ScrollPane fitToWidth="true" prefHeight="500" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="myItemsBox" spacing="10">
                           <padding><Insets bottom="10" right="4" /></padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </VBox>

            </HBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>
