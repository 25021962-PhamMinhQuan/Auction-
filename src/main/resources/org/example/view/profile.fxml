<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        styleClass="root"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.uicontroller.ProfileController">

   <!-- ══════════════ NAVBAR ══════════════ -->
   <top>
      <VBox styleClass="navbar-wrapper">
         <HBox alignment="CENTER_LEFT" spacing="10" styleClass="navbar">
            <padding><Insets top="10" bottom="10" left="16" right="16"/></padding>

            <Button styleClass="nav-logo-btn" onAction="#handleBack" mnemonicParsing="false">
               <graphic>
                  <ImageView fitHeight="38" fitWidth="85" preserveRatio="true" pickOnBounds="true">
                     <image><Image url="@../../../Auction_App.png"/></image>
                  </ImageView>
               </graphic>
            </Button>

            <Button text="%common.back"
                    styleClass="nav-link"
                    onAction="#handleBack"
                    mnemonicParsing="false"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="navUsernameLabel" text="Guest" styleClass="label-secondary"/>

            <Button styleClass="icon-btn" mnemonicParsing="false">
               <graphic>
                  <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" pickOnBounds="true">
                     <image><Image url="@../../../icon_user.png"/></image>
                  </ImageView>
               </graphic>
            </Button>
         </HBox>
         <Region styleClass="navbar-accent-line"/>
      </VBox>
   </top>

   <!-- ══════════════ CONTENT ══════════════ -->
   <center>
      <ScrollPane fitToWidth="true" styleClass="scroll-pane" BorderPane.alignment="CENTER">
         <content>
            <VBox alignment="TOP_CENTER">
               <padding><Insets top="40" bottom="60" left="20" right="20"/></padding>

               <VBox spacing="20" maxWidth="620" minWidth="320">

                  <!-- ── TIÊU ĐỀ TRANG ── -->
                  <VBox spacing="4">
                     <Label text="%profile.edit" styleClass="profile-page-title"/>
                     <Label text="%profile.subtitle"
                            styleClass="label-secondary"/>
                  </VBox>

                  <!-- ── CARD: AVATAR ── -->
                  <VBox spacing="16" styleClass="profile-card">
                     <HBox alignment="CENTER_LEFT" spacing="24">

                        <!-- Avatar tròn -->
                        <StackPane fx:id="avatarWrapper"
                                   minWidth="90" minHeight="90"
                                   maxWidth="90" maxHeight="90"
                                   styleClass="profile-avatar-wrap">
                           <ImageView fx:id="avatarImageView"
                                      fitWidth="86" fitHeight="86"
                                      preserveRatio="false"
                                      visible="false"/>
                           <Label fx:id="avatarPlaceholder" text="👤"
                                  styleClass="profile-avatar-icon"/>
                        </StackPane>

                        <!-- Thông tin bên cạnh avatar -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                           <Label fx:id="displayUsernameLabel" text="Username"
                                  styleClass="profile-display-name"/>
                           <Label fx:id="displayRoleLabel" text="BIDDER"
                                  styleClass="panel-role-badge" maxWidth="80"/>
                           <HBox spacing="10" alignment="CENTER_LEFT">
                              <Button fx:id="chooseAvatarBtn"
                                      text="%profile.choose_photo"
                                      styleClass="button-secondary"
                                      onAction="#handleChooseAvatar"
                                      mnemonicParsing="false"/>
                              <Button fx:id="removeAvatarBtn"
                                      text="%profile.remove_photo"
                                      styleClass="btn-danger"
                                      onAction="#handleRemoveAvatar"
                                      mnemonicParsing="false"
                                      visible="false"
                                      managed="false"/>
                           </HBox>
                           <Label text="%profile.photo_hint"
                                  styleClass="profile-hint-label"/>
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- ── CARD: THÔNG TIN CÁ NHÂN ── -->
                  <VBox spacing="16" styleClass="profile-card">
                     <Label text="%profile.personal_info" styleClass="profile-card-title"/>
                     <Region styleClass="profile-divider"/>

                     <VBox spacing="6">
                        <Label text="%profile.full_name" styleClass="profile-field-label"/>
                        <TextField fx:id="fullNameField"
                                   promptText="%profile.full_name.placeholder"
                                   styleClass="input_field, profile-field-input"
                                   maxWidth="1.7976931348623157E308"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="%profile.email" styleClass="profile-field-label"/>
                        <TextField fx:id="emailField"
                                   promptText="%profile.email.placeholder"
                                   styleClass="input_field, profile-field-input"
                                   maxWidth="1.7976931348623157E308"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="%profile.phone" styleClass="profile-field-label"/>
                        <TextField fx:id="phoneField"
                                   promptText="%profile.phone.placeholder"
                                   styleClass="input_field, profile-field-input"
                                   maxWidth="1.7976931348623157E308"/>
                     </VBox>

                     <Button text="%profile.save"
                             styleClass="button-login, profile-action-btn"
                             onAction="#handleSaveProfile"
                             mnemonicParsing="false"
                             maxWidth="1.7976931348623157E308"/>
                  </VBox>

                  <!-- ── CARD: ĐỔI MẬT KHẨU ── -->
                  <VBox spacing="16" styleClass="profile-card">
                     <Label text="%profile.change_password" styleClass="profile-card-title"/>
                     <Region styleClass="profile-divider"/>

                     <VBox spacing="6">
                        <Label text="%profile.current_password" styleClass="profile-field-label"/>
                        <PasswordField fx:id="oldPasswordField"
                                       promptText="%profile.current_password.placeholder"
                                       styleClass="input_field, profile-field-input"
                                       maxWidth="1.7976931348623157E308"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="%profile.new_password" styleClass="profile-field-label"/>
                        <PasswordField fx:id="newPasswordField"
                                       promptText="%profile.new_password.placeholder"
                                       styleClass="input_field, profile-field-input"
                                       maxWidth="1.7976931348623157E308"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="%profile.confirm_password" styleClass="profile-field-label"/>
                        <PasswordField fx:id="confirmPasswordField"
                                       promptText="%profile.confirm_password.placeholder"
                                       styleClass="input_field, profile-field-input"
                                       maxWidth="1.7976931348623157E208"/>
                     </VBox>

                     <Label text="%profile.password_hint"
                            wrapText="true"
                            styleClass="profile-hint-label"/>

                     <Button text="%profile.btn.change_password"
                             styleClass="button-login, profile-action-btn"
                             onAction="#handleChangePassword"
                             mnemonicParsing="false"
                             maxWidth="1.7976931348623157E308"/>
                  </VBox>

                  <!-- ── THÔNG BÁO TRẠNG THÁI ── -->
                  <StackPane fx:id="statusPane"
                             visible="false"
                             managed="false">
                     <Label fx:id="statusLabel"
                            wrapText="true"
                            maxWidth="1.7976931348623157E308"/>
                  </StackPane>

               </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>