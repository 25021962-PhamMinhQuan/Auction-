<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        styleClass="root"
        stylesheets="@../../../css/style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.uicontroller.ProfileController">

   <!-- ══════════════ NAVBAR ══════════════ -->
   <top>
      <VBox styleClass="navbar-wrapper">
         <HBox alignment="CENTER_LEFT" spacing="10" styleClass="navbar">
            <padding><Insets top="10" bottom="10" left="16" right="16"/></padding>

            <Button styleClass="nav-logo-btn" onAction="#handleBack" mnemonicParsing="false">
               <graphic>
                  <ImageView fitHeight="38" fitWidth="85" preserveRatio="true" pickOnBounds="true">
                     <image><Image url="@../../../Auction_App.png"/></image>
                  </ImageView>
               </graphic>
            </Button>

            <Button text="← Quay lại"
                    styleClass="nav-link"
                    onAction="#handleBack"
                    mnemonicParsing="false"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="navUsernameLabel" text="Guest" styleClass="label-secondary"/>

            <Button styleClass="icon-btn" mnemonicParsing="false">
               <graphic>
                  <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" pickOnBounds="true">
                     <image><Image url="@../../../icon_user.png"/></image>
                  </ImageView>
               </graphic>
            </Button>
         </HBox>
         <Region styleClass="navbar-accent-line"/>
      </VBox>
   </top>

   <!-- ══════════════ CONTENT ══════════════ -->
   <center>
      <ScrollPane fitToWidth="true" styleClass="scroll-pane" BorderPane.alignment="CENTER">
         <content>
            <VBox alignment="TOP_CENTER">
               <padding><Insets top="40" bottom="60" left="20" right="20"/></padding>

               <VBox spacing="20" maxWidth="620" minWidth="320">

                  <!-- ── TIÊU ĐỀ TRANG ── -->
                  <VBox spacing="4">
                     <Label text="Chỉnh sửa hồ sơ"
                            style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:#f9fafb;"/>
                     <Label text="Quản lý thông tin cá nhân và bảo mật tài khoản"
                            styleClass="label-secondary"/>
                  </VBox>

                  <!-- ── CARD: AVATAR ── -->
                  <VBox spacing="16"
                        style="-fx-background-color:#111827; -fx-background-radius:14;
                               -fx-border-color:#1f2937; -fx-border-radius:14;
                               -fx-border-width:1; -fx-padding:24;">
                     <HBox alignment="CENTER_LEFT" spacing="24">

                        <!-- Avatar tròn -->
                        <StackPane fx:id="avatarWrapper"
                                   minWidth="90" minHeight="90"
                                   maxWidth="90" maxHeight="90"
                                   style="-fx-background-color:linear-gradient(to bottom right,#374151,#1f2937);
                                          -fx-background-radius:999;
                                          -fx-border-color:#fbbf24;
                                          -fx-border-radius:999;
                                          -fx-border-width:2.5;">
                           <ImageView fx:id="avatarImageView"
                                      fitWidth="86" fitHeight="86"
                                      preserveRatio="false"
                                      visible="false"/>
                           <Label fx:id="avatarPlaceholder" text="👤"
                                  style="-fx-font-size:38px;"/>
                        </StackPane>

                        <!-- Thông tin bên cạnh avatar -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                           <Label fx:id="displayUsernameLabel" text="Username"
                                  style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#f9fafb;"/>
                           <Label fx:id="displayRoleLabel" text="BIDDER"
                                  styleClass="panel-role-badge" maxWidth="80"/>
                           <HBox spacing="10" alignment="CENTER_LEFT">
                              <Button fx:id="chooseAvatarBtn"
                                      text="📷  Chọn ảnh"
                                      styleClass="button-secondary"
                                      onAction="#handleChooseAvatar"
                                      mnemonicParsing="false"/>
                              <Button fx:id="removeAvatarBtn"
                                      text="✕  Xóa ảnh"
                                      styleClass="btn-danger"
                                      onAction="#handleRemoveAvatar"
                                      mnemonicParsing="false"
                                      visible="false"
                                      managed="false"/>
                           </HBox>
                           <Label text="PNG hoặc JPG. Kích thước tối đa 2MB."
                                  style="-fx-font-size:11px; -fx-text-fill:#4b5563;"/>
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- ── CARD: THÔNG TIN CÁ NHÂN ── -->
                  <VBox spacing="16"
                        style="-fx-background-color:#111827; -fx-background-radius:14;
                               -fx-border-color:#1f2937; -fx-border-radius:14;
                               -fx-border-width:1; -fx-padding:24;">
                     <Label text="Thông tin cá nhân"
                            style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#e5e7eb;"/>
                     <Region style="-fx-background-color:#1f2937; -fx-pref-height:1; -fx-min-height:1;"/>

                     <VBox spacing="6">
                        <Label text="Họ và tên"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#9ca3af;"/>
                        <TextField fx:id="fullNameField"
                                   promptText="Nhập họ và tên của bạn"
                                   styleClass="input_field"
                                   maxWidth="1.7976931348623157E308"
                                   style="-fx-pref-height:40px;"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="Email"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#9ca3af;"/>
                        <TextField fx:id="emailField"
                                   promptText="example@email.com"
                                   styleClass="input_field"
                                   maxWidth="1.7976931348623157E308"
                                   style="-fx-pref-height:40px;"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="Số điện thoại"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#9ca3af;"/>
                        <TextField fx:id="phoneField"
                                   promptText="0xxxxxxxxx"
                                   styleClass="input_field"
                                   maxWidth="1.7976931348623157E308"
                                   style="-fx-pref-height:40px;"/>
                     </VBox>

                     <Button text="💾  Lưu thay đổi"
                             styleClass="button-login"
                             onAction="#handleSaveProfile"
                             mnemonicParsing="false"
                             maxWidth="1.7976931348623157E308"
                             style="-fx-pref-height:42px; -fx-font-size:14px;"/>
                  </VBox>

                  <!-- ── CARD: ĐỔI MẬT KHẨU ── -->
                  <VBox spacing="16"
                        style="-fx-background-color:#111827; -fx-background-radius:14;
                               -fx-border-color:#1f2937; -fx-border-radius:14;
                               -fx-border-width:1; -fx-padding:24;">
                     <Label text="Đổi mật khẩu"
                            style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#e5e7eb;"/>
                     <Region style="-fx-background-color:#1f2937; -fx-pref-height:1; -fx-min-height:1;"/>

                     <VBox spacing="6">
                        <Label text="Mật khẩu hiện tại"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#9ca3af;"/>
                        <PasswordField fx:id="oldPasswordField"
                                       promptText="Nhập mật khẩu hiện tại"
                                       styleClass="input_field"
                                       maxWidth="1.7976931348623157E308"
                                       style="-fx-pref-height:40px;"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="Mật khẩu mới"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#9ca3af;"/>
                        <PasswordField fx:id="newPasswordField"
                                       promptText="Tối thiểu 6 ký tự, có chữ hoa, số và ký tự đặc biệt"
                                       styleClass="input_field"
                                       maxWidth="1.7976931348623157E308"
                                       style="-fx-pref-height:40px;"/>
                     </VBox>

                     <VBox spacing="6">
                        <Label text="Xác nhận mật khẩu mới"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#9ca3af;"/>
                        <PasswordField fx:id="confirmPasswordField"
                                       promptText="Nhập lại mật khẩu mới"
                                       styleClass="input_field"
                                       maxWidth="1.7976931348623157E308"
                                       style="-fx-pref-height:40px;"/>
                     </VBox>

                     <Label text="⚠  Mật khẩu cần có ít nhất 6 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt."
                            wrapText="true"
                            style="-fx-font-size:11px; -fx-text-fill:#4b5563;"/>

                     <Button text="🔒  Đổi mật khẩu"
                             styleClass="button-login"
                             onAction="#handleChangePassword"
                             mnemonicParsing="false"
                             maxWidth="1.7976931348623157E308"
                             style="-fx-pref-height:42px; -fx-font-size:14px;"/>
                  </VBox>

                  <!-- ── THÔNG BÁO TRẠNG THÁI ── -->
                  <StackPane fx:id="statusPane"
                             visible="false"
                             managed="false">
                     <Label fx:id="statusLabel"
                            wrapText="true"
                            maxWidth="1.7976931348623157E308"/>
                  </StackPane>

               </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>