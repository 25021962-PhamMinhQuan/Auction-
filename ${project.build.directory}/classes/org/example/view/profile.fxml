<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="509.0" prefWidth="835.0" styleClass="root" stylesheets="@../../../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.uicontroller.MainScreenController">
   <top>
      <HBox alignment="CENTER_LEFT"
            spacing="10"
            styleClass="navbar"
            BorderPane.alignment="CENTER_LEFT">
         <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>

         <Button mnemonicParsing="false" styleClass="nav-button">
            <graphic>
               <ImageView fitHeight="43" fitWidth="93"
                          pickOnBounds="true" preserveRatio="true"
                          styleClass="icon-button">
                  <image><Image url="@../../../Auction_App.png"/></image>
               </ImageView>
            </graphic>
         </Button>

         <StackPane fx:id="categoryBox">
            <Button fx:id="categoryButton"
                    text="Categories"
                    maxHeight="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="nav-button"/>
            <VBox fx:id="categoryMenu"
                  visible="false"
                  managed="false"
                  styleClass="dropdown-menu"
                  translateY="40">
               <Button text="Art"         mnemonicParsing="false" styleClass="dropdown-item"/>
               <Button text="Electronics" mnemonicParsing="false" styleClass="dropdown-item"/>
               <Button text="Other"       mnemonicParsing="false" styleClass="dropdown-item"/>
            </VBox>
         </StackPane>

         <StackPane fx:id="auctionBox">
            <Button fx:id="auctionButton"
                    text="Auctions"
                    maxHeight="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="nav-button"/>
            <VBox fx:id="auctionMenu"
                  visible="false"
                  managed="false"
                  styleClass="dropdown-menu"
                  translateY="40">
               <Button text="Upcoming" mnemonicParsing="false" styleClass="dropdown-item"/>
               <Button text="Ongoing"  mnemonicParsing="false" styleClass="dropdown-item"/>
            </VBox>
         </StackPane>

         <Button text="Introduction"
                 mnemonicParsing="false"
                 maxHeight="1.7976931348623157E308"
                 styleClass="nav-button"/>
         <Button text="Contact"
                 mnemonicParsing="false"
                 maxHeight="1.7976931348623157E308"
                 styleClass="nav-button"/>

         <Region HBox.hgrow="ALWAYS"/>

         <HBox alignment="CENTER_RIGHT" spacing="20">
            <padding><Insets right="10"/></padding>

            <Label fx:id="usernameLabel" styleClass="label-secondary" text="Guest"/>

            <Button mnemonicParsing="false" styleClass="icon-btn">
               <graphic>
                  <ImageView fitHeight="32" fitWidth="13"
                             pickOnBounds="true" preserveRatio="true"
                             styleClass="icon-img">
                     <image><Image url="@../../../find_icon.png"/></image>
                  </ImageView>
               </graphic>
            </Button>

            <Button mnemonicParsing="false" styleClass="icon-btn">
               <graphic>
                  <ImageView fitHeight="32" fitWidth="13"
                             pickOnBounds="true" preserveRatio="true"
                             styleClass="icon-img">
                     <image><Image url="@../../../icon_user.png"/></image>
                  </ImageView>
               </graphic>
            </Button>
         </HBox>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <VBox>
               <Button fx:id="backButton"
                       text="← Back"
                       visible="false"
                       managed="false"
                       mnemonicParsing="false"
                       onAction="#handleBack"
                       styleClass="button-login">
                  <VBox.margin>
                     <Insets top="10" bottom="10" left="10" right="10"/>
                  </VBox.margin>
               </Button>

               <ScrollPane fx:id="gridScroll"
                           fitToWidth="true"
                           visible="false"
                           managed="false">
                  <content>
                     <FlowPane fx:id="gridPane"
                               hgap="20" vgap="20"
                               styleClass="grid-pane"/>
                  </content>
               </ScrollPane>

               <VBox fx:id="mainContent"
                     alignment="TOP_CENTER"
                     spacing="20">
                  <padding><Insets top="40"/></padding>

                  <Label text="Upcoming Auction" styleClass="section-title"/>
                  <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToWidth="false">
                     <content>
                        <HBox fx:id="upcomingHbox" spacing="20"/>
                     </content>
                  </ScrollPane>
                  <Button fx:id="viewAllUpcoming"
                          text="View all"
                          mnemonicParsing="false"
                          onAction="#handleViewAllUpcoming"
                          styleClass="button-login"/>

                  <Label text="Ongoing Auction" styleClass="section-title"/>
                  <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="NEVER" fitToWidth="false">
                     <content>
                        <HBox fx:id="ongoingHbox" spacing="20"/>
                     </content>
                  </ScrollPane>
                  <Button fx:id="viewAllOngoing"
                          text="View all"
                          mnemonicParsing="false"
                          onAction="#handleViewAllOngoing"
                          styleClass="button-login"/>

               </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
